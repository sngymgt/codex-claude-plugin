{
  "description": "Optional stop-time review gate for the Claude companion, plus job cleanup at session end.",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/claude-companion.mjs\" session-end",
            "commandWindows": "node -e \"process.argv.splice(1,0,'x');import(require('url').pathToFileURL((process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT)+'/scripts/claude-companion.mjs'))\" session-end",
            "statusMessage": "Claude のジョブを片付けています",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/claude-companion.mjs\" stop-gate",
            "commandWindows": "node -e \"process.argv.splice(1,0,'x');import(require('url').pathToFileURL((process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT)+'/scripts/claude-companion.mjs'))\" stop-gate",
            "statusMessage": "Claude が変更を確認しています（レビューゲート）",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
